# rsge-mcp configuration. Copy to .env and fill in. .env is gitignored.

# Environment: "test" (default) or "prod".
# - test: if no eAPI credentials are set below, the documented PUBLIC test account
#         (username Tbilisi) is used automatically. Safe; no real data.
# - prod: credentials are REQUIRED; no test fallback is ever injected.
RSGE_ENV=test

# --- eAPI (REST/JSON) bearer-token credentials ---
RSGE_EAPI_USERNAME=
RSGE_EAPI_PASSWORD=
# Optional GUID to let the server be remembered as a known device.
RSGE_EAPI_DEVICE_CODE=

# --- Two-factor (SMS OTP) handling ---
# off        : account has no 2FA (the public test account).
# static_pin : auto-submit RSGE_PIN (app-generated / fixed PIN).
# tool       : expose an rsge_submit_pin tool so a human enters the SMS code.
RSGE_2FA_MODE=off
RSGE_PIN=

# --- SOAP service-user credentials (Phase 2; waybills / VAT invoices) ---
RSGE_SOAP_USER=
RSGE_SOAP_TIN=
RSGE_SOAP_PASSWORD=

# --- HTTP behavior ---
RSGE_HTTP_TIMEOUT=30
RSGE_RATE_DELAY_MS=300

# --- Base URLs (override only to target the rs.ge test hosts) ---
# RSGE_EAPI_BASE=https://eapi.rs.ge                # eAPI has no separate test host (test mode on prod)
# RSGE_XDATA_BASE=https://xdata-test.rs.ge         # REST/xData test host
# RSGE_SOAP_BASE=https://services-test.rs.ge       # SOAP test host (waybill/taxpayer/custompost).
#                                                  # Only scheme+host are used; the .asmx path is kept.

# Set to 1 to enable the opt-in live integration smoke tests.
# Set RSGE_ALLOW_WRITES=1 as well to allow the gated live SOAP write test (draft save/delete).
RSGE_RUN_INTEGRATION=
